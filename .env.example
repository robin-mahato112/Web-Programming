# Copy to .env to override. The INFT3050 Docker backend listens on port 3001
# and only accepts browser requests from http://localhost:3000 (the Vite dev port).
VITE_API_URL=http://localhost:3001

# Extra code admins enter at Staff sign in. Checked in the browser only, so it is a convenience
# gate for this prototype, not real security: the value ships in the JavaScript bundle.
VITE_ADMIN_CODE=ADMIN001
