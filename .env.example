# Same-origin proxy avoids separate cookies for localhost and 127.0.0.1.
VITE_API_URL=/backend
API_PROXY_TARGET=http://127.0.0.1:3001
# For local staff UI experiments only. Never enabled in production builds.
VITE_ENABLE_MOCK_ADMIN=false

# Extra code admins enter at Staff sign in. Checked in the browser only, so it is a convenience
# gate for this prototype, not real security: the value ships in the JavaScript bundle.
VITE_ADMIN_CODE=ADMIN001
