              "if (pm.environment.get('baseUrl') !== 'http://localhost:13002' || pm.environment.get('allowIsolatedManagementEdit') !== 'true') { pm.execution.skipRequest(); throw new Error('Management writes require isolated 13002 and explicit opt-in.'); }"
