            ]
          }
        }
      ]
    },
    {
      "name": "Management - Delete unordered product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/admin/products/{{productId}}",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Management-Request",
            "value": "1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('baseUrl') !== 'http://localhost:13002' || pm.environment.get('allowIsolatedManagementEdit') !== 'true') { pm.execution.skipRequest(); throw new Error('Management writes require isolated 13002 and explicit opt-in.'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Management - Edit staff account",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/admin/users/{{staffUserId}}",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Management-Request",
            "value": "1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{managementBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('baseUrl') !== 'http://localhost:13002' || pm.environment.get('allowIsolatedManagementEdit') !== 'true') { pm.execution.skipRequest(); throw new Error('Management writes require isolated 13002 and explicit opt-in.'); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Management - Delete staff account",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/admin/users/{{staffUserId}}",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Management-Request",
            "value": "1"
          }
        ],
        "body": {
          "mode": "raw",
